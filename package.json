{
  "name": "workpier",
  "productName": "WorkPier",
  "version": "2.8.0",
  "description": "同一个网站同时登录多个账号，侧边栏一点就切，不用退出重登。",
  "author": "SirKayZh",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
