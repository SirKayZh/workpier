    "test": "vitest run",
    "start": "electron .",
    "package": "./scripts/package.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "44.7.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
